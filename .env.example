# Threat Intelligence MCP Server - API Configuration
# Copy this file to .env and fill in your API keys

# VirusTotal API Key
# Get your free API key at: https://www.virustotal.com/gui/join-us
# Free tier: 4 requests/minute, 500 requests/day
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# AbuseIPDB API Key  
# Get your free API key at: https://www.abuseipdb.com/account/api
# Free tier: 1,000 requests/day
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Shodan API Key
# Get your API key at: https://account.shodan.io/register
# Free tier: 100 results/month
SHODAN_API_KEY=your_shodan_api_key_here

# GitHub Personal Access Token (used for GitHub Models inference API)
# Get your PAT at: https://github.com/settings/tokens
# Requires no special scopes for GitHub Models access
GITHUB_TOKEN=your_github_pat_here

# MalwareBazaar API Key
# Get your free API key at: https://bazaar.abuse.ch/api/
MALWAREBAZAAR_API_KEY=your_malwarebazaar_api_key_here

# Note: NVD and MITRE ATT&CK APIs do not require API keys
